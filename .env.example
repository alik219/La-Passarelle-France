# Copy this file to .env and fill in your own values. Never commit .env.

# Which AI runs Claire: "ollama" (free, on your computer) or "gemini" (Google API)
LLM_PROVIDER=ollama

# --- Ollama (https://ollama.com) ---
# Download the model once with: ollama pull gemma3:4b
OLLAMA_MODEL=gemma3:4b
OLLAMA_URL=http://127.0.0.1:11434

# --- Gemini (only used when LLM_PROVIDER=gemini) ---
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Used automatically when the main model is out of free quota or busy
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# How much Gemini may "think" before answering (0 = fastest, 512 = better corrections)
GEMINI_THINKING_BUDGET=512

# Claire's voice (Microsoft Edge neural voices via edge-tts)
TTS_VOICE=fr-FR-DeniseNeural

# Backend port (the Vite dev server proxies /api here)
PORT=8000
